{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.md\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: invoke the matching rseng-* skills for research-software work (router: rseng-quality-framework); keep aidecl.yaml current.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,sys;d=json.load(sys.stdin);s=(d.get('tool_input') or {}).get('skill');s and open('.rseng-agent-skills-usage.log','a').write(s+chr(10))\""
          }
        ]
      }
    ]
  }
}
